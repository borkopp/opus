# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=your-development-deployment

NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# Production: opus.mk. Local tenant hosts such as `studio-luna.localhost:3000`
# are recognized automatically while this remains set to opus.mk.
NEXT_PUBLIC_ROOT_DOMAIN=opus.mk

# Set these on the Convex deployment with `npx convex env set`, not in the
# browser bundle. Use `console` only for isolated local terminal delivery.
SITE_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-a-long-random-secret
# Optional dedicated HMAC/encryption key for public booking OTPs. When omitted,
# BETTER_AUTH_SECRET is used so existing deployments remain operational.
BOOKING_OTP_SECRET=
AUTH_EMAIL_MODE=resend
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Required for email OTP delivery in local and non-local environments.
RESEND_API_KEY=
AUTH_EMAIL_FROM=noreply@opus.mk

# Optional fixed six-digit OTP for local automated tests only.
AUTH_TEST_OTP=
