# Use the same Convex deployment as opus-dashboard. Both values are public.
EXPO_PUBLIC_CONVEX_URL=https://calm-dachshund-294.convex.cloud
# OTP goes through the existing signed Next.js proxy.
EXPO_PUBLIC_DASHBOARD_URL=https://studio.opus.mk

# Public ingestion URL for the dedicated, EU-region OPUS mobile Sentry project.
EXPO_PUBLIC_SENTRY_DSN=https://fdeb62b761730878f976885e35d25e0d@o4508979194298368.ingest.de.sentry.io/4512212669628496
# Build/OTA source-map upload only. Set privately in EAS; never EXPO_PUBLIC_*.
# SENTRY_AUTH_TOKEN=<restricted Sentry organization source-map token>
# SENTRY_ORG=borko-petrevski
# SENTRY_PROJECT=opus-mobile

# Set these in EAS environments when preparing a release. Do not invent a project ID.
# APP_ENV=production
# EAS_PROJECT_ID=634b3403-0012-42f0-9cc1-a5725f12f2cc
# GOOGLE_SERVICES_JSON=<EAS file variable containing this Android app's google-services.json>
# Configure the FCM v1 service-account key and APNs push key with EAS credentials.
# Those private credentials and the backend Expo/VAPID secrets must never be EXPO_PUBLIC_*.

# Optional native-only URL for a local phone while web uses loopback.
# EXPO_PUBLIC_NATIVE_DASHBOARD_URL=http://192.168.1.20:3000
# Do not configure a native local override in production / preview EAS environments.
# OTA publishes use scripts/ota.cjs to fetch the correct EAS environment and disable dotenv.
