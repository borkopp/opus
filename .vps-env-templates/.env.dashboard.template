# ─────────────────────────────────────────────────────────────────────────────
# Runtime secrets for opus-dashboard container
# Copy this to /opt/opus/.env.dashboard on the VPS and fill in real values.
# This file is NOT committed to git — secrets stay on the server.
# ─────────────────────────────────────────────────────────────────────────────

# Better Auth runs in Convex, not this Next.js container. Configure SITE_URL,
# BETTER_AUTH_SECRET, AUTH_TRUSTED_ORIGINS, RESEND_API_KEY, and AUTH_EMAIL_FROM
# on the production Convex deployment.

# Convex deployment (cloud-hosted — the production deployment slug)
CONVEX_DEPLOYMENT=prod:your-deployment-name

# Twilio / Resend (if used at runtime)
TWILIO_ACCOUNT_SID=...
TWILIO_AUTH_TOKEN=...
RESEND_API_KEY=re_...

# Anthropic (AI actions)
ANTHROPIC_API_KEY=sk-ant-...
