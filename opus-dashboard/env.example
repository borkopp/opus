# Local deployment used by `npx convex dev`.
CONVEX_DEPLOYMENT=your-development-deployment

NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# Production: opus.mk. Local tenant hosts such as `studio-luna.localhost:3000`
# are recognized automatically while this remains set to opus.mk.
NEXT_PUBLIC_ROOT_DOMAIN=opus.mk
# Convex environment: opening-offer links use this tenant root (default opus.mk).
# Set with the Convex CLI when it differs from production; keep it aligned above.
ROOT_DOMAIN=opus.mk

# PostHog browser analytics configuration.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host
# Local analytics is off by default. Opt in only when testing analytics.
NEXT_PUBLIC_ANALYTICS_IN_DEV=false

# The same Meta web Pixel / Dataset ID used by opus-landing.
# Leave empty to disable Meta Pixel. This is a public ID, not an access token.
# Set in the Vercel project before building/deploying.
NEXT_PUBLIC_META_PIXEL_ID=

# Vercel only: create separate production and preview deploy keys in Convex,
# then store each key in the matching Vercel environment. Never commit a key.
# `npx convex deploy` injects both NEXT_PUBLIC_CONVEX_* URLs during the build.
# CONVEX_DEPLOY_KEY=generated-in-the-convex-dashboard

# Set these on the Convex deployment with `npx convex env set`, not in the
# browser bundle. Use `console` only for isolated local terminal delivery.
SITE_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-a-long-random-secret
# Optional dedicated HMAC/encryption key for public booking OTPs. When omitted,
# BETTER_AUTH_SECRET is used so existing deployments remain operational.
BOOKING_OTP_SECRET=
# `providers` uses the ordered provider lists below. Legacy `resend` remains
# accepted and behaves the same when the lists contain only Resend.
AUTH_EMAIL_MODE=providers
AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Safe defaults keep the existing Resend-only behavior until Sender is fully
# verified. Production can use: auth=resend,sender; booking=sender,resend;
# reminders=sender. Provider names are evaluated left to right.
AUTH_EMAIL_PROVIDERS=resend
BOOKING_EMAIL_PROVIDERS=resend
REMINDER_EMAIL_PROVIDERS=resend

# Resend API and signed delivery-event webhook.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Sender REST is used for OTP and other messages without attachments. Sender
# SMTP over TLS is used when OPUS must preserve generated .ics attachments.
SENDER_API_TOKEN=
SENDER_SMTP_HOST=smtp.sender.net
SENDER_SMTP_PORT=587
SENDER_SMTP_USER=
SENDER_SMTP_PASSWORD=

# Resend uses the route addresses below. Sender can override each route when a
# different domain is verified there. Empty Sender overrides fall back to the
# corresponding route address.
AUTH_EMAIL_FROM=login@auth.opus.mk
BOOKING_EMAIL_FROM=bookings@bookings.opus.mk
SENDER_AUTH_EMAIL_FROM=login@opus.mk
SENDER_BOOKING_EMAIL_FROM=

# Pro appointment SMS — set on the Convex deployment, never NEXT_PUBLIC_*.
# See docs/SMS_NOTIFICATIONS.md. Keep disabled until delivery is verified.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Use a Messaging Service or an SMS-capable E.164 sender number.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
# Optional override; defaults to CONVEX_SITE_URL/webhooks/twilio.
# The callback must be publicly reachable over HTTPS.
TWILIO_STATUS_CALLBACK_URL=

# Optional fixed six-digit OTP for local automated tests only.
AUTH_TEST_OTP=

# Development data controls are local-only and must remain unset in production.
ALLOW_DEV_DATA=

# Business assistant — set on the Convex deployment, never NEXT_PUBLIC_*.
# Keep disabled until the provider key and rollout checks are complete.
BUSINESS_ANALYST_ENABLED=false
BUSINESS_ANALYST_OPENAI_API_KEY=

# Instagram AI frontdesk — Convex deployment variables, never NEXT_PUBLIC_*.
# See docs/AI_FRONTDESK.md. Keep disabled until Meta configuration is complete.
AI_FRONTDESK_ENABLED=false
AI_FRONTDESK_OPENAI_API_KEY=
# OPENAI_API_KEY is accepted as a fallback when a dedicated key is not set.
AI_FRONTDESK_MODEL=gpt-6-luna
AI_FRONTDESK_DAILY_REPLY_LIMIT=500
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
FRONTDESK_TOKEN_SECRET=

# Polar monthly Pro subscriptions — Convex deployment variables only.
# See docs/POLAR_BILLING.md. Use separate sandbox and production deployments.
# Disabling new checkout keeps reconciliation and the billing portal working.
POLAR_ENABLED=false
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRO_PRODUCT_ID=
