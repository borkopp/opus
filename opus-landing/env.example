# Use the same PostHog project token and host as opus-dashboard.
# Both are required. Set in the landing Vercel project before building/deploying.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# The same Meta web Pixel / Dataset ID used by opus-dashboard.
# Leave empty to disable Meta Pixel. Set in Vercel before building/deploying.
NEXT_PUBLIC_META_PIXEL_ID=
