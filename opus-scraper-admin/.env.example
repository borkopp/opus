# Copy to .env and fill in values. Never commit .env.

# No Google API key needed — OSM/Overpass is used for place data (free, no billing).

# Convex deployment URL (from opus-dashboard/.env.local or Convex dashboard)
CONVEX_URL=

# Shared secret — set in Convex env too:  npx convex env set ADMIN_API_KEY <value>
ADMIN_API_KEY=

# Used by the Vite dev server (prefix with VITE_ so Vite inlines it)
VITE_CONVEX_URL=
VITE_ADMIN_API_KEY=
