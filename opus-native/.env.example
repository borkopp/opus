# Copy to .env.local and adjust for your machine.
# Expo SDK 55 inlines only EXPO_PUBLIC_* vars into the bundle.
# https://docs.expo.dev/guides/environment-variables/

# Local Convex dev (run from opus-dashboard: npm run dev:backend)
EXPO_PUBLIC_CONVEX_URL=http://127.0.0.1:3210

# Production only — Convex HTTP site URL (*.convex.site). Not needed for local dev (storage uses :3210).
# EXPO_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Physical device (Expo Go): keep 127.0.0.1 — the app rewrites to your Mac's LAN IP
# automatically (same host as Metro's exp:// URL). Only set manually if that fails:
# EXPO_PUBLIC_CONVEX_URL=http://192.168.1.42:3210

# Mapbox Static Images API — no native build required, works in Expo Go
# Get your public token at https://console.mapbox.com/account/access-tokens/
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ...

# Clerk (optional — for ConvexProviderWithClerk later)
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
