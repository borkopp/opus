# Same deployment as opus-dashboard. These are public deployment addresses,
# not deploy keys. The owner app never deploys Convex or receives an admin key.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
OWNER_SITE_URL=http://localhost:3002
NEXT_PUBLIC_ROOT_DOMAIN=opus.mk

# Production: OWNER_SITE_URL=https://admin.opus.mk
# Add that exact origin to AUTH_TRUSTED_ORIGINS on the Convex deployment too.
