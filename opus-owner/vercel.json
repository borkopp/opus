{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "ignoreCommand": "git log -1 --format=%B | grep -Fq '[skip deploy]'",
  "git": {
    "deploymentEnabled": {
      "codex/hospitality-vertical": false
    }
  }
}
